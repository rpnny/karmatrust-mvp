{
  "name": "karmatrust-mvp",
  "version": "0.1.0",
  "description": "On-chain credit scoring with zero-knowledge privacy",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "contracts"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=frontend",
    "test:contracts": "npm run test --workspace=contracts"
  },
  "keywords": [
    "credit-score",
    "defi",
    "zero-knowledge",
    "ethereum",
    "vcsm",
    "privacy"
  ],
  "author": "KarmaTrust Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
