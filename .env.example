# ===========================================
# KarmaTrust MVP - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# Backend Server
PORT=3000
API_URL=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:3000/api

# ===========================================
# Blockchain Configuration
# ===========================================

# RPC URLs (at least one required)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com
ALCHEMY_API_KEY=

# Etherscan API (for on-chain data fetching)
ETHERSCAN_API_KEY=

# ===========================================
# EAS (Ethereum Attestation Service)
# ===========================================
# Required for creating real on-chain attestations
# Leave empty to use simulation mode

PRIVATE_KEY=

# EAS Contract Addresses (Sepolia)
EAS_CONTRACT_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
SCHEMA_REGISTRY_ADDRESS=0x0a7E2Ff54e76B8E6659aedc9103FB21c038050D0

# ===========================================
# Smart Contracts (after deployment)
# ===========================================

VCSM_STATE_MANAGER_ADDRESS=
ZKP_VERIFIER_ADDRESS=

# ===========================================
# ZK Circuits
# ===========================================

CIRCUIT_WASM_PATH=circuits/build/tier_membership_js/tier_membership.wasm
CIRCUIT_ZKEY_PATH=circuits/build/tier_membership.zkey
