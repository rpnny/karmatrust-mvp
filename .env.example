# ===========================================
# KarmaTrust MVP - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# Backend Server
PORT=3000
API_URL=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:3000/api

# ===========================================
# Blockchain Configuration
# ===========================================

# RPC URLs (Sepolia testnet - recommended: Tatum)
SEPOLIA_RPC_URL=https://ethereum-sepolia.gateway.tatum.io

# Base Sepolia RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Mainnet RPC (for production data fetching)
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Etherscan API (for detailed on-chain data)
ETHERSCAN_API_KEY=

# Basescan API
BASESCAN_API_KEY=

# Alchemy API (optional, for enhanced data)
ALCHEMY_API_KEY=

# ===========================================
# EAS (Ethereum Attestation Service)
# ===========================================

# Your wallet private key (for signing attestations)
# WARNING: Never commit real private keys!
PRIVATE_KEY=

# EAS Contract Addresses (Sepolia)
EAS_CONTRACT_ADDRESS=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
SCHEMA_REGISTRY_ADDRESS=0x0a7E2Ff54e76B8E6659aedc9103FB21c038050D0

# ===========================================
# Smart Contracts (after deployment)
# ===========================================

VCSM_STATE_MANAGER_ADDRESS=
ZKP_VERIFIER_ADDRESS=
CREDIT_REGISTRY_V2_ADDRESS=
LENDING_CONTRACT_ADDRESS=

# ===========================================
# ZK Circuits
# ===========================================

CIRCUIT_WASM_PATH=circuits/build/tier_membership_js/tier_membership.wasm
CIRCUIT_ZKEY_PATH=circuits/build/tier_membership.zkey

# ===========================================
# Reclaim Protocol (zkTLS - Plan B for TLSNotary)
# ===========================================
# Get credentials at: https://dev.reclaimprotocol.org/
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# ===========================================
# Paymaster (Gas Sponsorship)
# ===========================================
# Separate key for the paymaster (optional, falls back to PRIVATE_KEY)
PAYMASTER_PRIVATE_KEY=

# ===========================================
# Frontend Wallet Connect
# ===========================================
# Get project ID at: https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_SEPOLIA_RPC=https://ethereum-sepolia.gateway.tatum.io
VITE_CREDIT_REGISTRY_V2_ADDRESS=
VITE_LENDING_CONTRACT_ADDRESS=
VITE_VERIFIER_ADDRESS=

# ===========================================
# Database (PostgreSQL + Prisma)
# ===========================================
DATABASE_URL=postgresql://localhost:5432/karmatrust
